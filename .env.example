# Copy to .env and fill in. Never commit the real .env file.

# Required. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Optional. Defaults to a SQLite file in ./instance/household.db
# DATABASE_URL=sqlite:////home/yourusername/JazzClubAdmin/instance/household.db

# Timezone used for "today", due dates and recurrence.
TIMEZONE=Europe/London

# Name shown in the app header and on the home screen icon.
APP_NAME=Nest

# Only send cookies over HTTPS. Keep this on in production (PythonAnywhere is HTTPS).
# Set to 0 for local development over http://localhost.
SESSION_COOKIE_SECURE=1

# Allow anyone who finds the site to create an account.
# Set to 0 once your household exists: people can still join via an invite link.
ALLOW_REGISTRATION=1

# Where Info attachments (photos/PDFs) are stored, and the per-request upload limit.
# UPLOAD_DIR=/home/yourusername/JazzClubAdmin/instance/uploads
# MAX_UPLOAD_MB=20
